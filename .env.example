# ==========================================
# 1. COMPETITION SANDBOX (NETWORK COMMANDS)
# ==========================================
# The token the organizers gave you to execute commands remotely
COMPETITION_API_TOKEN=<your-competition-token>

# The remote execution endpoint (Phase 2 Overseas Region as an example)
COMPETITION_API_URL=https://124.71.227.61/ip/api/agent/execute

# ==========================================
# 2. LARGE LANGUAGE MODEL (LLM) SETTINGS
# ==========================================
# The organizers DO NOT provide the LLM. 
# You still need to run the massive Qwen3.5-35B-A3B model yourself!
# Since your GPU only has 6GB VRAM, you MUST use an external API (like OpenRouter)
# or rent a massive GPU server.

# If you create an OpenRouter account, put your OpenRouter token here (starts with sk-or-v1-...)
LLM_API_KEY=<your-openrouter-key>

# OpenRouter Endpoint
LLM_ENDPOINT=https://openrouter.ai/api/v1/chat/completions

# The exact model to use 
LLM_MODEL=Qwen3.5-35B-A3B
