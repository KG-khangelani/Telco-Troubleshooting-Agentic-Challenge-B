FROM node:20-slim

# Install Python and basic utilities since the dataset scripts are in Python
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install pi-agent and other required libraries in the root directory so ESM resolution finds them
# This keeps them off the host volume mounted at /app
RUN mkdir /temp_deps && cd /temp_deps && npm init -y && \
    npm install @earendil-works/pi-coding-agent csv-parser typebox && \
    mv node_modules /node_modules && \
    rm -rf /temp_deps
CMD ["tail", "-f", "/dev/null"]
