FROM node:20-slim

# Install Python and basic utilities since the dataset scripts are in Python
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install pi-agent and other required libraries globally so they don't pollute the host workspace
RUN npm install -g @earendil-works/pi-coding-agent csv-parser typebox

# Ensure global node modules can be required by scripts
ENV NODE_PATH=/usr/local/lib/node_modules
CMD ["tail", "-f", "/dev/null"]
